{
  "@@locale": "pt",
  "authAppName": "Gerenciador de Tarefas",
   "@authAppName": {
     "description": "App name displayed on auth screens"
   },

   "authLoginTitle": "Bem-vindo de Volta",
   "@authLoginTitle": {
     "description": "Login screen title"
   },

   "authRegisterTitle": "Criar Conta",
   "@authRegisterTitle": {
     "description": "Register screen title"
   },

   "authEmail": "E-mail",
   "@authEmail": {
     "description": "Email field label"
   },

   "authEmailHint": "Enter your email",
   "@authEmailHint": {
     "description": "Email field hint text"
   },

   "authPassword": "Senha",
   "@authPassword": {
     "description": "Password field label"
   },

   "authPasswordHint": "Digite sua senha",
   "@authPasswordHint": {
     "description": "Password field hint text"
   },

   "authConfirmPassword": "Confirmar Senha",
   "@authConfirmPassword": {
     "description": "Confirm password field label"
   },

   "authName": "Nome",
   "@authName": {
     "description": "Name field label for registration"
   },

   "authNameHint": "Digite seu nome completo",
   "@authNameHint": {
     "description": "Name field hint text"
   },

   "authLoginButton": "Entrar",
   "@authLoginButton": {
     "description": "Login button text"
   },

   "authRegisterButton": "Criar Conta",
   "@authRegisterButton": {
     "description": "Register button text"
   },

   "authSignUp": "Cadastrar",
   "@authSignUp": {
     "description": "Sign up link text"
   },

   "authSignIn": "Entrar",
   "@authSignIn": {
     "description": "Sign in link text"
   },

   "authWithoutAccount": "Não tem uma conta?",
   "@authWithoutAccount": {
     "description": "Text asking if user doesn't have an account"
   },

   "authAlreadyHaveAccount": "Já tem uma conta?",
   "@authAlreadyHaveAccount": {
     "description": "Text asking if user already has an account"
   },

   "authEmailError": "Por favor, insira um endereço de e-mail válido",
   "@authEmailError": {
     "description": "Error message for invalid email"
   },

   "authPasswordError": "A senha deve ter pelo menos 8 caracteres",
   "@authPasswordError": {
     "description": "Error message for invalid password"
   },

   "authPasswordTooShort": "A senha deve ter pelo menos {minLength} caracteres",
   "@authPasswordTooShort": {
     "description": "Error message when password is too short",
     "placeholders": {
       "minLength": {
         "type": "int",
         "example": "8"
       }
     }
   },

   "authNameError": "O nome não deve estar vazio",
   "@authNameError": {
     "description": "Error message for empty name field"
   },

   "authNameTooShort": "O nome deve ter pelo menos 2 caracteres",
   "@authNameTooShort": {
     "description": "Error message when name is too short"
   },

   "authConfirmPasswordError": "As senhas não coincidem",
   "@authConfirmPasswordError": {
     "description": "Error message when passwords don't match"
   },

   "authLoginError": "Falha no login: {error}",
   "@authLoginError": {
     "description": "Generic login error message",
     "placeholders": {
       "error": {
         "type": "String",
         "example": "Invalid credentials"
       }
     }
   },

   "authRegisterError": "Falha no registro: {error}",
   "@authRegisterError": {
     "description": "Generic registration error message",
     "placeholders": {
       "error": {
         "type": "String",
         "example": "Email already exists"
       }
     }
   },

   "authForgotPassword": "Esqueceu a senha?",
   "@authForgotPassword": {
     "description": "Forgot password link text"
   },

   "authResetPassword": "Redefinir Senha",
   "@authResetPassword": {
     "description": "Reset password button text"
   },

   "authLogout": "Sair",
   "@authLogout": {
     "description": "Logout button text"
   },

   "authLoggingIn": "Entrando...",
   "@authLoggingIn": {
     "description": "Loading text while logging in"
   },

   "authCreatingAccount": "Criando conta...",
   "@authCreatingAccount": {
     "description": "Loading text while creating account"
   }
